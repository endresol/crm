// ClientManager clone — Prisma schema
// Phase 1 (auth): Workspace, User, Session
// Phase 2 (clients) and Phase 3 (time tracking) models are added additively below
// as those phases land — see /SPEC.md and /docs/feature-audit for the full target model.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A tenant. Every User and every piece of business data (Client, TimeEntry, ...)
/// belongs to exactly one Workspace.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  clients     Client[]
  timeEntries TimeEntry[]
  projects    Project[]
  tasks       Task[]

  @@map("workspaces")
}

enum UserRole {
  MASTER_ADMIN
}

/// An admin-app principal (as opposed to a future Client Portal Contact principal).
model User {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(MASTER_ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions    Session[]
  timeEntries TimeEntry[]

  @@index([workspaceId])
  @@map("users")
}

/// A server-side, DB-backed session. The httpOnly cookie only ever holds this row's id.
model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A client the workspace does business with. Trimmed field set for now —
/// see docs/feature-audit/01-clients.md for the full real-product model.
model Client {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  legalName   String?
  email       String?
  website     String?
  industry    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]
  projects    Project[]

  @@index([workspaceId])
  @@map("clients")
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

/// A project of work delivered for a Client. Trimmed field set for now —
/// see docs/feature-audit/07-projects-tasks.md for the full real-product model.
model Project {
  id          String        @id @default(cuid())
  workspaceId String
  clientId    String
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?     @db.Date
  endDate     DateTime?     @db.Date
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([workspaceId])
  @@index([clientId])
  @@map("projects")
}

/// Matches the real product's task-status set (see docs/feature-audit/07-projects-tasks.md),
/// used for both the kanban board and the future Gantt legend.
enum TaskStatus {
  TODO
  DOING
  READY_FOR_QA
  BLOCKED
  DONE
}

/// A unit of work within a Project. Trimmed field set for now (no assignees yet —
/// that needs multi-user workspaces, see roadmap #5) — see docs/feature-audit/07-projects-tasks.md
/// for the full real-product model.
model Task {
  id          String     @id @default(cuid())
  workspaceId String
  projectId   String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueDate     DateTime?  @db.Date
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([projectId])
  @@map("tasks")
}

/// A logged block of time worked for a Client. Trimmed field set for now —
/// see docs/feature-audit/08-time-tracking.md for the full real-product model.
model TimeEntry {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String
  userId      String
  minutes     Int
  description String?
  date        DateTime @db.Date
  billable    Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([clientId])
  @@map("time_entries")
}
