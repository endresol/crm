DATABASE_URL="postgresql://cmclone:cmclone@localhost:5440/cmclone?schema=public"

# Random 32+ byte secret used to sign the session cookie. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-me-with-a-real-secret"

# Optional. Set only in production, to the Client Portal's own hostname (see
# proxy.ts) — e.g. client.normadicstudio.com. Requires adding that hostname
# as a second custom domain on the Vercel project and pointing its CNAME at
# Vercel in your DNS registrar. Leave unset for local dev / preview deploys:
# the portal stays reachable by path (/portal/login) on whatever host you're
# already using.
# PORTAL_HOST="client.normadicstudio.com"
