// ClientManager clone — Prisma schema
// Phase 1 (auth): Workspace, User, Session
// Phase 2 (clients) and Phase 3 (time tracking) models are added additively below
// as those phases land — see /SPEC.md and /docs/feature-audit for the full target model.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A tenant. Every User and every piece of business data (Client, TimeEntry, ...)
/// belongs to exactly one Workspace.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  clients          Client[]
  contacts         Contact[]
  deals            Deal[]
  leads            Lead[]
  sops             Sop[]
  calendarEvents   CalendarEvent[]
  timeEntries      TimeEntry[]
  projects         Project[]
  tasks            Task[]
  milestones       Milestone[]
  products         Product[]
  discounts        Discount[]
  priceBooks       PriceBook[]
  priceBookEntries PriceBookEntry[]

  @@map("workspaces")
}

enum UserRole {
  MASTER_ADMIN
}

/// An admin-app principal (as opposed to a future Client Portal Contact principal).
model User {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(MASTER_ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions       Session[]
  timeEntries    TimeEntry[]
  calendarEvents CalendarEvent[]

  @@index([workspaceId])
  @@map("users")
}

/// A server-side, DB-backed session. The httpOnly cookie only ever holds this row's id.
model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A client the workspace does business with. Trimmed field set for now —
/// see docs/feature-audit/01-clients.md for the full real-product model.
model Client {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  legalName   String?
  email       String?
  website     String?
  industry    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  timeEntries    TimeEntry[]
  projects       Project[]
  contacts       Contact[]
  deals          Deal[]
  convertedLeads Lead[]

  @@index([workspaceId])
  @@map("clients")
}

/// A person belonging to a Client (roadmap #1). Trimmed field set for now — no
/// status/source/type/role/social links yet, those enums weren't observable in
/// the audit. See docs/feature-audit/02-contacts.md for the full real-product model.
model Contact {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String
  fullName    String
  jobTitle    String?
  email       String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deals     Deal[]

  @@index([workspaceId])
  @@index([clientId])
  @@map("contacts")
}

/// Matches the real product's kanban lane set (see docs/feature-audit/03-deals.md).
/// Closed outcomes are stages rather than a separate Status field — the audit's
/// Stage and Status fields overlapped enough (both end at "closed") that we
/// collapsed them into one, same trimming approach as Contact dropping its
/// unclear enum fields.
enum DealStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum DealPriority {
  LOW
  MEDIUM
  HIGH
}

/// A sales opportunity attached to a Client (+ optional Contact), moving through
/// pipeline Stages toward Closed Won/Lost (roadmap #7). Trimmed field set for now
/// (no deal_no, deal type, discount, lead source, or next-follow-up date yet) —
/// see docs/feature-audit/03-deals.md for the full real-product model.
model Deal {
  id                String       @id @default(cuid())
  workspaceId       String
  clientId          String
  contactId         String?
  name              String
  description       String?
  amount            Float        @default(0)
  currency          String       @default("USD")
  stage             DealStage    @default(PROSPECTING)
  priority          DealPriority @default(MEDIUM)
  expectedCloseDate DateTime?    @db.Date
  nextStep          String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([clientId])
  @@index([contactId])
  @@map("deals")
}

/// Matches the real product's status stepper (see docs/feature-audit/05-leads.md).
enum LeadStatus {
  NEW
  UNQUALIFIED
  CONTACTED
  QUALIFIED
  CONVERTED
}

/// A pre-Client inbound prospect (roadmap #8), separate from Deal's pipeline.
/// Converting a Lead creates a Client + Contact from its data and flips status
/// to CONVERTED (the Lead row is kept, not deleted, as conversion history).
/// Trimmed field set for now (no lead_no, rating, currency-on-budget, comments,
/// or archiving yet) — see docs/feature-audit/05-leads.md for the full
/// real-product model.
model Lead {
  id                String     @id @default(cuid())
  workspaceId       String
  name              String
  email             String?
  phone             String?
  businessName      String?
  website           String?
  budget            Float?
  source            String?
  description       String?
  status            LeadStatus @default(NEW)
  convertedClientId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  convertedClient Client?   @relation(fields: [convertedClientId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([convertedClientId])
  @@map("leads")
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

/// A project of work delivered for a Client. Trimmed field set for now —
/// see docs/feature-audit/07-projects-tasks.md for the full real-product model.
model Project {
  id          String        @id @default(cuid())
  workspaceId String
  clientId    String
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?     @db.Date
  endDate     DateTime?     @db.Date
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks       Task[]
  milestones  Milestone[]
  timeEntries TimeEntry[]

  @@index([workspaceId])
  @@index([clientId])
  @@map("projects")
}

/// Groups Tasks within a Project around a target date. Trimmed field set for now —
/// see docs/feature-audit/07-projects-tasks.md for the full real-product model.
model Milestone {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String
  name        String
  dueDate     DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([workspaceId])
  @@index([projectId])
  @@map("milestones")
}

/// Matches the real product's task-status set (see docs/feature-audit/07-projects-tasks.md),
/// used for both the kanban board and the future Gantt legend.
enum TaskStatus {
  TODO
  DOING
  READY_FOR_QA
  BLOCKED
  DONE
}

/// A unit of work within a Project. Trimmed field set for now (no assignees yet —
/// that needs multi-user workspaces, see roadmap #5) — see docs/feature-audit/07-projects-tasks.md
/// for the full real-product model.
model Task {
  id          String     @id @default(cuid())
  workspaceId String
  projectId   String
  milestoneId String?
  title       String
  description String?
  status      TaskStatus @default(TODO)
  startDate   DateTime?  @db.Date
  dueDate     DateTime?  @db.Date
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone   Milestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([milestoneId])
  @@map("tasks")
}

/// A logged block of time worked for a Client, optionally scoped to a Project/Task
/// within that Client. Trimmed field set for now —
/// see docs/feature-audit/08-time-tracking.md for the full real-product model.
model TimeEntry {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String
  projectId   String?
  taskId      String?
  userId      String
  minutes     Int
  description String?
  date        DateTime @db.Date
  billable    Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([clientId])
  @@index([projectId])
  @@index([taskId])
  @@map("time_entries")
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum ProductUnit {
  EACH
  HOUR
  DAY
  WEEK
  MONTH
  PROJECT
}

/// A product or service the workspace sells — a reusable line item for future
/// Invoices/Proposals/Deals (see docs/roadmap.md). Pricing intentionally does NOT
/// live on the Product — see PriceBookEntry, which lets the same Product carry a
/// different price per PriceBook. Trimmed field set for now — see
/// docs/feature-audit/06-products.md for the full real-product model.
model Product {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  code        String
  family      String?
  type        ProductType @default(PRODUCT)
  unit        ProductUnit @default(EACH)
  description String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  priceBookEntries PriceBookEntry[]

  @@index([workspaceId])
  @@map("products")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// A reusable discount, applied to line items on future Invoices/Proposals/Deals
/// (see docs/roadmap.md). `value` is a percentage (0-100) when type is PERCENTAGE,
/// or a currency amount when type is FIXED_AMOUNT. Stored as Float rather than
/// Decimal — trimmed for the clone, same simplification as TimeEntry.minutes being
/// a plain Int — see docs/feature-audit/06-products.md for the full real-product model.
model Discount {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  type        DiscountType @default(PERCENTAGE)
  value       Float
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("discounts")
}

/// A named collection of Product prices (e.g. "Standard", "Wholesale") — see
/// docs/feature-audit/06-products.md.
model PriceBook {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   PriceBookEntry[]

  @@index([workspaceId])
  @@map("price_books")
}

/// Assigns a Product a price within a PriceBook. One entry per (priceBook, product).
model PriceBookEntry {
  id          String   @id @default(cuid())
  workspaceId String
  priceBookId String
  productId   String
  unitPrice   Float
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  priceBook PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceBookId, productId])
  @@index([workspaceId])
  @@index([priceBookId])
  @@index([productId])
  @@map("price_book_entries")
}

/// A lightweight personal calendar event (roadmap #4's "Calendar" tab only —
/// the real product's "Meetings"/booking-page half of this nav item is
/// roadmap #19, Meeting Scheduler, built separately on top of this).
/// Trimmed field set for now — no attendees/location/description, no Google
/// Calendar sync. See docs/feature-audit/04-calendar.md for the full
/// real-product model.
model CalendarEvent {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  title       String
  startAt     DateTime
  endAt       DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@map("calendar_events")
}

/// An internal knowledge-base document (roadmap #3) — not associated with any
/// Client/Project. "Create SOP" auto-creates a draft and opens it, same as the
/// real product's Google-Docs-style flow. Trimmed field set for now — content
/// is plain text rather than the real product's rich-text/WYSIWYG editor (no
/// editor library in this repo yet), and there's no upload/share/read-only-view
/// distinction. See docs/feature-audit/12-sops.md for the full real-product model.
model Sop {
  id          String   @id @default(cuid())
  workspaceId String
  title       String   @default("Untitled SOP")
  content     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("sops")
}
